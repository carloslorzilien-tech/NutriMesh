rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de lotes: lectura pública (URL firmada para el banco),
    // escritura solo para usuarios autenticados o chofer con token (vía Cloud Function en producción).
    match /batches/{batchId}/{fileName} {
      allow read:  if true;  // la URL es privada por ser firmada
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024   // máx 8 MB
        && request.resource.contentType.matches('image/.*');
    }
  }
}
